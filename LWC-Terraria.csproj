<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <RootNamespace>LWCTerraria</RootNamespace>
    <AssemblyName>LWC</AssemblyName>
    <Description>LWC simplified for Terraria</Description>
    <FileVersion>1.0.1</FileVersion>
    <Version>0.6.1.0</Version>
    <TargetFramework>net9.0</TargetFramework>
    <Copyright>Tyler Blair 2011</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <PostBuildEvent>cp $(OutDir)LWC.dll /opt/tshock/ServerPlugins/</PostBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="TShock" Version="6.1.0" />
    <!--<PackageReference Include="OTAPI" Version="2.0.0.50" />-->
  </ItemGroup>
